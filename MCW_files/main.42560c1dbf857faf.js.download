07\u0928 \u0915\u094d\u092f\u093e\u0938\u093f\u0928\u094b \u0917\u0947\u092e\u093f\u0919\u0926\u0947\u0916\u093f \u0932\u093f\u090f\u0930 \u092b\u0941\u091f\u092c\u0932 \u0930 \u0915\u094d\u0930\u093f\u0915\u0947\u091f\u091c\u0938\u094d\u0924\u093e \u0932\u094b\u0915\u092a\u094d\u0930\u093f\u092f \u0916\u0947\u0932\u092a\u094d\u0930\u0924\u093f \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u0940\u092f \u0930\u0941\u091a\u093f\u0932\u093e\u0908 \u0938\u092e\u094d\u092c\u094b\u0927\u0928 \u0917\u0930\u094d\u0928\u0947 \u0935\u093f\u0936\u093e\u0932 \u0938\u094d\u092a\u094b\u0930\u094d\u091f\u094d\u0938\u092c\u0941\u0915\u0938\u092e\u094d\u092e\u0915\u094b \u0921\u093f\u091c\u093f\u091f\u0932 \u092e\u0928\u094b\u0930\u091e\u094d\u091c\u0928\u0915\u094b \u0905\u0924\u094d\u092f\u0928\u094d\u0924\u0948 \u092b\u0930\u093e\u0915\u093f\u0932\u094b \u0926\u093e\u092f\u0930\u093e \u092a\u094d\u0930\u0926\u093e\u0928 \u0917\u0930\u094d\u091b\u0964"),r.k0s(),r.nrm(6,"br"),r.j41(7,"p"),r.EFF(8,"\u0927\u0947\u0930\u0948\u091c\u0938\u094b \u092a\u094d\u0930\u0924\u093f\u0937\u094d\u0920\u093f\u0924 \u0905\u0928\u094d\u0924\u0930\u094d\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u093f\u092f \u0917\u0947\u092e\u093f\u0919 \u092a\u094d\u0930\u092e\u093e\u0923\u0928 \u0928\u093f\u0915\u093e\u092f\u0939\u0930\u0942\u092c\u093e\u091f \u0907\u091c\u093e\u091c\u0924\u092a\u0924\u094d\u0930 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0917\u0930\u0947\u0930, \u092e\u0947\u0917\u093e \u0915\u094d\u092f\u093e\u0938\u093f\u0928\u094b \u0935\u0930\u094d\u0932\u094d\u0921\u0932\u0947 \u0909\u091a\u094d\u091a\u0924\u092e \u092a\u093e\u0930\u0926\u0930\u094d\u0936\u093f\u0924\u093e \u092e\u093e\u092a\u0926\u0923\u094d\u0921\u0939\u0930\u0942 \u092a\u093e\u0932\u0928 \u0917\u0930\u094d\u0926\u091b, \u091c\u0938\u0932\u0947 \u0928\u0947\u092a\u093e\u0932\u0940\u0939\u0930\u0942\u0932\u093e\u0908 \u0909\u0928\u0940\u0939\u0930\u0942\u0915\u094b \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 \u0930\u0915\u092e\u092e\u093e \u0906\u0927\u093e\u0930\u093f\u0924 \u092c\u0947\u091f\u093f\u0919 \u0930 \u0917\u0947\u092e\u093f\u0919 \u0938\u0947\u0935\u093e\u0939\u0930\u0942\u092e\u093e \u092a\u0942\u0930\u094d\u0923 \u0935\u093f\u0936\u094d\u0935\u0938\u0928\u0940\u092f\u0924\u093e \u092a\u094d\u0930\u0926\u093e\u0928 \u0917\u0930\u094d\u091b\u0964 \u0938\u094d\u0925\u093e\u0928\u093f\u092f \u0930\u0941\u091a\u093f \u0930 \u0938\u0902\u0935\u0947\u0926\u0928\u0936\u0940\u0932\u0924\u093e\u0932\u093e\u0908 \u0905\u0928\u094d\u0924\u0930\u094d\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u093f\u092f \u0909\u0924\u094d\u0915\u0943\u0937\u094d\u091f \u0905\u092d\u094d\u092f\u093e\u0938\u0939\u0930\u0942\u0938\u0901\u0917 \u0938\u092e\u093e\u0928 \u0930\u0942\u092a\u092e\u093e \u0938\u092e\u093e\u092f\u094b\u091c\u0928 \u0917\u0930\u094d\u0926\u0948, \u0916\u0947\u0932\u0915\u094b \u0938\u094d\u0935\u0930\u0942\u092a\u092e\u093e \u0917\u0939\u093f\u0930\u094b \u0930\u0942\u092a\u092e\u093e \u0938\u092e\u0947\u091f\u093f\u090f\u0915\u094b \u091b\u0964"),r.k0s(),r.nrm(9,"br"),r.j41(10,"p"),r.EFF(11,"\u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0930\u0942\u092a\u092e\u093e \u0935\u093f\u0936\u094d\u0935\u092d\u0930 \u0932\u094b\u0915\u092a\u094d\u0930\u093f\u092f \u0915\u094d\u092f\u093e\u0938\u093f\u0928\u094b \u0916\u0947\u0932\u0939\u0930\u0942 \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0917\u0930\u094d\u0928\u0947 \u092e\u0947\u0917\u093e \u0915\u094d\u092f\u093e\u0938\u093f\u0928\u094b \u0935\u0930\u094d\u0932\u094d\u0921 (MCW) \u0932\u0947 \u0906\u092b\u0942\u0932\u093e\u0908 \u0905\u091d \u0905\u0932\u0917 \u092c\u0928\u093e\u0909\u0928\u0947 \u0935\u093f\u0936\u0947\u0937\u0924\u093e \u092d\u0928\u0947\u0915\u094b \u092f\u0938\u0915\u094b \u0905\u0928\u0932\u093e\u0907\u0928 \u0938\u094d\u0932\u091f\u094d\u0938 \u0930 \u091f\u0947\u092c\u0932 \u0917\u0947\u092e\u0939\u0930\u0942\u0915\u094b \u0938\u0902\u0917\u094d\u0930\u0939 \u0939\u094b, \u091c\u0938\u092e\u093e \u0927\u0947\u0930\u0948 \u0916\u0947\u0932\u0939\u0930\u0942\u092e\u093e \u0928\u0947\u092a\u093e\u0932\u0940\u092a\u0928 \u091d\u0932\u094d\u0915\u093f\u0928\u0947 \u092a\u094d\u0930\u0924\u0940\u0915\u093e\u0924\u094d\u092e\u0915 \u0926\u0943\u0936\u094d\u092f \u0930 \u0915\u0932\u093e\u0924\u094d\u092e\u0915\u0924\u093e \u0938\u092e\u093e\u0935\u0947\u0936 \u0917\u0930\u093f\u090f\u0915\u094b \u091b \u2014 \u091c\u0938\u0932\u0947 \u0938\u094d\u0925\u093e\u0928\u093f\u092f \u0916\u0947\u0932\u092a\u094d\u0930\u0947\u092e\u0940\u0939\u0930\u0942\u0932\u093e\u0908 \u092a\u0930\u093f\u091a\u093f\u0924 \u0930 \u0906\u0924\u094d\u092e\u0940\u092f \u0905\u0928\u0941\u092d\u0935 \u0926\u093f\u0932\u093e\u0909\u0901\u0926\u0948 \u092e\u0928\u094b\u0930\u091e\u094d\u091c\u0928\u0915\u094b \u092a\u094d\u0930\u092d\u093e\u0935\u0932\u093e\u0908 \u0909\u0932\u094d\u0932\u0947\u0916\u0928\u0940\u092f \u0930\u0942\u092a\u092e\u093e \u092c\u0922\u093e\u0909\u0901\u091b\u0964 \u0924\u094d\u092f\u0938\u0948\u0917\u0930\u0940, \u0938\u094d\u092a\u094b\u0930\u094d\u091f\u094d\u0938\u092c\u0941\u0915 \u092a\u094d\u0932\u0947\u091f\u092b\u0930\u094d\u092e\u0932\u0947 \u0928\u0947\u092a\u093e\u0932\u0940 \u092a\u094d\u0930\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0939\u0930\u0942\u0932\u093e\u0908 \u0935\u093f\u0926\u0947\u0936\u0940 \u0916\u0947\u0932\u0939\u0930\u0942\u092e\u093e \u0930\u092e\u093e\u0909\u0901\u0926\u0948 \u0917\u0930\u094d\u0926\u093e \u092a\u0928\u093f \u0906\u092b\u094d\u0928\u0948 \u0938\u0939\u091c\u0924\u093e \u0930 \u092a\u0930\u093f\u091a\u092f\u0915\u094b \u0905\u0928\u0941\u092d\u0942\u0924\u093f \u0926\u093f\u0932\u093e\u0909\u0928\u0947 \u0938\u0941\u0935\u093f\u0927\u093e \u092a\u094d\u0930\u0926\u093e\u0928 \u0917\u0930\u094d\u0926\u091b\u0964"),r.k0s(),r.nrm(12,"br"),r.j41(13,"p"),r.EFF(14,"\u092f\u0939\u093e\u0901 \u0935\u094d\u092f\u093e\u092a\u0915 \u092c\u0947\u091f\u093f\u0919 \u092e\u093e\u0930\u094d\u0915\u0947\u091f\u0939\u0930\u0942 \u0909\u092a\u0932\u092c\u094d\u0927 \u091b\u0928\u094d, \u091c\u0938\u0932\u0947 \u092a\u094d\u0930\u0924\u093f\u0937\u094d\u0920\u093f\u0924 \u0905\u0928\u094d\u0924\u0930\u094d\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u093f\u092f \u0932\u093f\u0917\u0939\u0930\u0942 \u0938\u092e\u0947\u091f\u094d\u091b\u0928\u094d \u2014 \u091c\u0939\u093e\u0901 \u0928\u0947\u092a\u093e\u0932\u0915\u093e \u091a\u0930\u094d\u091a\u093f\u0924 \u0916\u0947\u0932\u093e\u0921\u0940\u0939\u0930\u0942, \u091c\u0938\u094d\u0924\u0948 \u0915\u0940\u0930\u094d\u0924\u093f\u092e\u093e\u0928\u0940 \u0915\u094d\u0930\u093f\u0915\u0947\u091f\u0930 \u0932\u093e\u092e\u093f\u091b\u093e\u0928\u0947, \u092a\u094d\u0930\u0924\u093f\u0938\u094d\u092a\u0930\u094d\u0927\u093e \u0917\u0930\u094d\u091b\u0928\u094d \u2014 \u0938\u093e\u0925\u0948 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u093f\u092f \u0915\u094d\u0930\u093f\u0915\u0947\u091f \u0930 \u0909\u0926\u093e\u0909\u0901\u0926\u094b \u092b\u0941\u091f\u092c\u0932\u091c\u0938\u094d\u0924\u093e \u0938\u094d\u0925\u093e\u0928\u093f\u092f \u0916\u0947\u0932\u0939\u0930\u0942\u0915\u094b \u092a\u0928\u093f \u0938\u092e\u093e\u0928 \u0930\u0942\u092a\u092e\u093e \u0935\u093f\u0938\u094d\u0924\u0943\u0924 \u0915\u0935\u0930\u0947\u091c \u092a\u094d\u0930\u0926\u093e\u0928 \u0917\u0930\u093f\u0928\u094d\u091b\u0964 \u0916\u0947\u0932\u093e\u0921\u0940\u0939\u0930\u0942\u0932\u0947 \u092f\u0939\u093e\u0901 \u0905\u0928\u094c\u092a\u091a\u093e\u0930\u093f\u0915 \u092e\u093e\u0927\u094d\u092f\u092e\u0939\u0930\u0942\u092d\u0928\u094d\u0926\u093e \u092a\u094d\u0930\u0924\u093f\u0938\u094d\u092a\u0930\u094d\u0927\u093e\u0924\u094d\u092e\u0915 \u0926\u0930\u0939\u0930\u0942 \u092a\u093e\u0909\u0901\u091b\u0928\u094d\u0964"),r.k0s(),r.nrm(15,"br"),r.j41(16,"p"),r.EFF(17,"\u092a\u094d\u0930\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0915\u094b \u0926\u0940\u0930\u094d\u0918\u0915\u093e\u0932\u0940\u0928 \u0935\u093f\u0936\u094d\u0935\u093e\u0938 \u0905\u091d \u092e\u091c\u092c\u0941\u0924 \u092c\u0928\u093e\u0909\u0901\u0926\u0948, \u092e\u0947\u0917\u093e \u0915\u094d\u092f\u093e\u0938\u093f\u0928\u094b \u0935\u0930\u094d\u0932\u094d\u0921 (MCW) \u0932\u0947 \u0915\u0921\u093e\u0907\u0915\u093e \u0938\u093e\u0925 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0909\u092a\u093e\u092f\u0939\u0930\u0942 \u0932\u093e\u0917\u0942 \u0917\u0930\u094d\u0926\u091b \u2014 \u0907\u0928\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u0938\u0928\u0926\u094d\u0935\u093e\u0930\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0932\u0947\u0928\u0926\u0947\u0928 \u0930 \u092d\u0942-\u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092a\u094d\u0930\u0923\u093e\u0932\u0940\u0926\u0947\u0916\u093f \u0932\u093f\u090f\u0930 \u0928\u0947\u092a\u093e\u0932\u0940 \u092d\u093e\u0937\u093e\u092e\u093e \u0938\u0947\u0935\u093e \u0926\u093f\u0928\u0947 \u0917\u094d\u0930\u093e\u0939\u0915 \u0938\u0939\u093e\u092f\u0924\u093e \u091f\u094b\u0932\u0940\u0938\u092e\u094d\u092e, \u091c\u0938\u0932\u0947 \u0916\u093e\u0924\u093e\u0938\u092e\u094d\u092c\u0928\u094d\u0927\u0940 \u0938-\u0938\u093e\u0928\u093e \u091c\u093f\u091c\u094d\u091e\u093e\u0938\u093e\u0939\u0930\u0942\u0932\u093e\u0908 \u092a\u0928\u093f \u0938\u0939\u091c \u0930\u0942\u092a\u092e\u093e \u0938\u092e\u093e\u0927\u093e\u0928 \u0917\u0930\u094d\u091b\u0964"),r.k0s(),r.nrm(18,"br"),r.j41(19,"p"),r.EFF(20,"\u0935\u093f\u0936\u094d\u0935\u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u0905\u0928\u0941\u092e\u0924\u093f\u092a\u0924\u094d\u0930\u0939\u0930\u0942\u0905\u0928\u094d\u0924\u0930\u094d\u0917\u0924 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930 \u0928\u093f\u092f\u092e\u0928 \u0917\u0930\u093f\u090f\u0915\u094b \u0905\u0928\u0932\u093e\u0907\u0928 \u092e\u0928\u094b\u0930\u091e\u094d\u091c\u0928\u0915\u094b \u0936\u093f\u0916\u0930 \u0916\u094b\u091c\u094d\u0928\u0947 \u0928\u0947\u092a\u093e\u0932\u0940\u09