\u093e\u0930\u0924 \u092e\u0947\u0902 \u0915\u094d\u0930\u093f\u0915\u0947\u091f \u090f\u0915\u094d\u0938\u091a\u0947\u0902\u091c \u0914\u0930 \u0915\u0948\u0938\u0940\u0928\u094b \u0938\u093e\u0907\u091f\u0947\u0902"),r.k0s(),r.j41(3,"div",2)(4,"p"),r.EFF(5,"\u092d\u093e\u0930\u0924 \u092e\u0947\u0902 \u0938\u0930\u094d\u0935\u0936\u094d\u0930\u0947\u0937\u094d\u0920 \u0938\u091f\u094d\u091f\u0947\u092c\u093e\u091c\u0940 \u0938\u093e\u0907\u091f \u091a\u0941\u0928\u0928\u0947 \u0915\u0940 \u091a\u0941\u0928\u094c\u0924\u0940 \u0928\u094c\u0938\u093f\u0916\u093f\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0905\u0927\u093f\u0915 \u0915\u0920\u093f\u0928 \u0939\u094b \u0917\u0908 \u0939\u0948\u0964 \u092f\u0926\u093f \u0906\u092a \u092a\u0902\u091c\u0940\u0915\u0930\u0923 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0924\u094b \u0915\u0908 \u0938\u093e\u0907\u091f\u0947\u0902 \u0939\u0948\u0902 \u091c\u094b \u0906\u092a\u0915\u094b \u092c\u094b\u0928\u0938 \u092e\u0928\u0940 \u0915\u0940 \u092a\u0947\u0936\u0915\u0936 \u0915\u0930\u0924\u0940 \u0939\u0948\u0902, \u0932\u0947\u0915\u093f\u0928 \u092f\u0939 \u0909\u0928\u094d\u0939\u0947\u0902 \u0905\u0928\u094d\u092f \u0915\u0948\u0938\u0940\u0928\u094b \u0915\u0940 \u0924\u0941\u0932\u0928\u093e \u092e\u0947\u0902 \u092c\u0947\u0939\u0924\u0930 \u0928\u0939\u0940\u0902 \u092c\u0928\u093e\u0924\u093e \u0939\u0948 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u092f\u0939 \u0926\u0947\u0916\u0928\u0947 \u092a\u0930 \u0935\u093f\u091a\u093e\u0930 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0908 \u0905\u0928\u094d\u092f \u0932\u094b\u0917\u094b\u0902 \u092e\u0947\u0902 \u0938\u0947 \u0915\u0947\u0935\u0932 \u090f\u0915 \u0915\u093e\u0930\u0915 \u0939\u0948 \u0915\u093f \u0915\u094c\u0928 \u0938\u0940 \u0917\u0947\u092e\u093f\u0902\u0917 \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u0906\u092a\u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e\u0913\u0902 \u0915\u0947 \u0905\u0928\u0941\